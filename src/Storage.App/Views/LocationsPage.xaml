<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.LocationsPage"
             x:DataType="vm:LocationsViewModel"
             Title="Locations">

    <Shell.TitleView>
        <views:LocationTitleView RootTitle="Locations"
                                 BindingContext="{Binding Context}" />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Header: search, then add a location. Items come from the Snap button. -->
        <HorizontalStackLayout Grid.Row="0"
                               Margin="10"
                               Spacing="10"
                               HorizontalOptions="End">
            <Button Text="{Binding Search.ToggleIcon}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding Search.ToggleCommand}"
                    SemanticProperties.Description="{Binding Search.ToggleDescription}"
                    ToolTipProperties.Text="{Binding Search.ToggleDescription}" />
            <Button Text="➕"
                    Style="{StaticResource IconButton}"
                    Command="{Binding NavigateToCreateCommand}"
                    SemanticProperties.Description="Add a location"
                    ToolTipProperties.Text="Add a location" />
        </HorizontalStackLayout>

        <!-- Its own row: a path three levels deep needs the full width. -->
        <views:LocationPathBar Grid.Row="1"
                               BindingContext="{Binding Context}" />

        <!-- The same toolbar the items page uses, so the search does not change shape
             depending on which tab it was opened from. -->
        <views:SearchToolbar x:Name="Toolbar"
                             Grid.Row="2"
                             BindingContext="{Binding Search}" />

        <!-- Locations: the ones at this level when browsing, the matches when searching.
             Swipe-to-delete lives here only — this is the page that manages them. -->
        <RefreshView Grid.Row="3"
                     BindingContext="{Binding Search}"
                     IsVisible="{Binding ShowLocationList}"
                     IsRefreshing="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=IsLoading}"
                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=LoadLocationsCommand}">
            <CollectionView ItemsSource="{Binding Locations}"
                            ItemTemplate="{StaticResource DeletableLocationRow}"
                            EmptyViewTemplate="{StaticResource EmptyState}">
                <CollectionView.Footer>
                    <ContentView HeightRequest="{StaticResource SnapClearance}" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Items, when the toggle is flipped: found without leaving this page. -->
        <CollectionView Grid.Row="3"
                        BindingContext="{Binding Search}"
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding ShowItemList}"
                        ItemTemplate="{StaticResource ItemRow}"
                        EmptyViewTemplate="{StaticResource EmptyState}">
            <CollectionView.Footer>
                <ContentView HeightRequest="{StaticResource SnapClearance}" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Last in the grid so it draws over both lists. -->
        <Button Grid.Row="3"
                Style="{StaticResource SnapButton}"
                Command="{Binding Context.SnapCommand}" />
    </Grid>

</ContentPage>
