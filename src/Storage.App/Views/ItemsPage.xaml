<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             x:Class="Storage.App.Views.ItemsPage"
             x:DataType="vm:ItemsViewModel"
             Title="My Items">

    <Grid RowDefinitions="Auto,*">
        <!-- Header with Add Button -->
        <Button Grid.Row="0"
                Text="Add Item"
                Command="{Binding NavigateToAddItemCommand}"
                Margin="10"
                HorizontalOptions="End" />

        <!-- Items List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadItemsCommand}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="Center">
                        <Label Text="No items yet"
                               FontSize="20"
                               HorizontalTextAlignment="Center"
                               TextColor="Gray" />
                        <Label Text="Tap 'Add Item' to get started"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="Gray"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,5" Padding="10" CornerRadius="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="Gray"
                                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="{Binding Location.Name, StringFormat='Location: {0}'}"
                                           FontSize="12"
                                           TextColor="DarkGray"
                                           IsVisible="{Binding Location, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                                           FontSize="12"
                                           TextColor="LightGray" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
