<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.ItemDetailPage"
             x:DataType="vm:ItemDetailViewModel"
             Title="{Binding Name}"
             Shell.NavBarIsVisible="False">

    <!-- Shell's bar is hidden: the back and menu buttons sit over the photo, or on the
         canvas when there is none, the same as on a location's page. -->
    <Grid RowDefinitions="*,Auto">

        <!-- Hidden, not just covered, while the item is missing: a screen reader would
             otherwise still reach the stepper and Edit underneath the message. -->
        <ScrollView Grid.Row="0"
                    IsVisible="{Binding IsMissing, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout>

                <Grid>
                    <!-- Full width: on this page the photo is the fastest way to confirm
                         this is the thing you were looking for. AspectFit, not
                         AspectFill — a crop can hide the very detail that tells two
                         similar items apart. -->
                    <Grid HeightRequest="360"
                          IsVisible="{Binding HasPhotos}"
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}">
                        <!-- Swipe for the rest of the set, starting on the primary. Its
                             scroll is horizontal, so it does not fight the page's own. -->
                        <CarouselView ItemsSource="{Binding Photos}"
                                      IndicatorView="PhotoIndicator"
                                      Loop="False"
                                      HorizontalScrollBarVisibility="Never">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="models:ItemPhoto">
                                    <Image Source="{Binding FileName, Converter={StaticResource PhotoSourceConverter}}"
                                           Aspect="AspectFit"
                                           SemanticProperties.Description="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemDetailViewModel}}, Path=Name, StringFormat='Photo of {0}'}" />
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <!-- Dots earn their space only once there is a second photo. They
                             sit over the photo, which can be any colour, so they carry
                             their own scrim. -->
                        <Border IsVisible="{Binding HasMultiplePhotos}"
                                HorizontalOptions="Center"
                                VerticalOptions="End"
                                Margin="0,0,0,14"
                                Padding="10,5"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#66000000">
                            <IndicatorView x:Name="PhotoIndicator"
                                           IndicatorColor="#80FFFFFF"
                                           SelectedIndicatorColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="20,16,20,0"
                          VerticalOptions="Start">
                        <Button Grid.Column="0"
                                Text="←"
                                Style="{StaticResource RoundIconButton}"
                                Command="{Binding BackCommand}"
                                SemanticProperties.Description="Back" />
                        <Button Grid.Column="2"
                                Text="⋯"
                                Style="{StaticResource RoundIconButton}"
                                Command="{Binding ShowActionsCommand}"
                                SemanticProperties.Description="{Binding Name, StringFormat='More for {0}, including delete'}" />
                    </Grid>
                </Grid>

                <VerticalStackLayout Padding="20,20,20,24" Spacing="20">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource Display}"
                               FontSize="28"
                               SemanticProperties.HeadingLevel="Level1" />

                        <!-- Where it is, as a link to that location's page. Shown as a
                             sentence when there is none: "where is it" is the question
                             this page exists to answer, so "nowhere yet" is an answer. -->
                        <Border Style="{StaticResource PlaceChip}"
                                HorizontalOptions="Start"
                                Padding="12,0,14,0"
                                IsVisible="{Binding HasLocation}"
                                SemanticProperties.Description="{Binding LocationPath, StringFormat='Stored in {0}. Opens that location'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLocationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding LocationPath, StringFormat='📍 {0}'}"
                                   Style="{StaticResource StrongLabel}"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimarySoft}, Dark={StaticResource OnPrimarySoftDark}}" />
                        </Border>
                        <Label Text="No location yet"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding HasLocation, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>

                    <!-- The quantity changes right here, saved as it goes: using one of
                         something is the edit people make most, and it should not take
                         a trip through the whole form. -->
                    <Border Style="{StaticResource Card}" Padding="18,12,12,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Quantity" Style="{StaticResource Caption}" FontFamily="JakartaSemiBold" />
                                <Label Text="{Binding Quantity}"
                                       Style="{StaticResource Title}"
                                       SemanticProperties.Description="{Binding Quantity, StringFormat='Quantity {0}'}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="−"
                                    Style="{StaticResource RoundIconButton}"
                                    FontSize="22"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"
                                    Command="{Binding DecreaseQuantityCommand}"
                                    SemanticProperties.Description="Decrease quantity" />
                            <Button Grid.Column="2"
                                    Text="+"
                                    Style="{StaticResource RoundIconButton}"
                                    FontSize="22"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Command="{Binding IncreaseQuantityCommand}"
                                    SemanticProperties.Description="Increase quantity" />
                        </Grid>
                    </Border>

                    <!-- Read-only chips in each tag's own colour; editing them is the form's job. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                                Wrap="Wrap"
                                IsVisible="{Binding HasTags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Style="{StaticResource Chip}"
                                        Margin="0,0,8,8"
                                        BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}">
                                    <Label Text="{Binding Name}"
                                           FontFamily="JakartaBold"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasDescription}">
                        <Label Text="Description" Style="{StaticResource Caption}" FontFamily="JakartaSemiBold" />
                        <Label Text="{Binding Description}" LineHeight="1.4" />
                    </VerticalStackLayout>

                    <Label Text="{Binding CreatedAt, StringFormat='Added {0:d MMM yyyy}'}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The one big action. Delete is not down here: the edit form's Save sits in
             this spot and pops straight back to this page, so a double tap on Save
             would land on whatever is here. -->
        <Button Grid.Row="1"
                Text="Edit"
                Style="{StaticResource StrongButton}"
                Command="{Binding EditCommand}"
                IsVisible="{Binding IsMissing, Converter={StaticResource InvertedBoolConverter}}"
                Margin="20,8,20,16"
                SemanticProperties.Description="{Binding Name, StringFormat='Edit {0}'}" />

        <!-- Deleted while this page was underneath another one. Said plainly, with a
             way out, instead of popping during OnAppearing. -->
        <VerticalStackLayout Grid.RowSpan="2"
                             IsVisible="{Binding IsMissing}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"
                             Padding="32"
                             Spacing="16">
            <Label Text="This item no longer exists"
                   Style="{StaticResource Title}"
                   HorizontalTextAlignment="Center"
                   Margin="0,120,0,0" />
            <Button Text="Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
