<?xml version="1.0" encoding="utf-8" ?>
<!-- The item's fields, without the header or Save: shared by the edit page and the
     create page, which each put their own around it. Bound to an AddItemViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.ItemForm"
             x:DataType="vm:AddItemViewModel">

    <VerticalStackLayout Spacing="18">

        <!-- Photos, in the order they will be shown; the first is the main one, the one
             lists use as the thumbnail. The camera and gallery tiles come after them, as
             "add more": most photos now arrive from the camera before the form opens.
             The strip scrolls sideways because ten thumbnails do not fit across a phone. -->
        <VerticalStackLayout Spacing="8">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="0,-6,-20,0">
                <HorizontalStackLayout Spacing="4" Padding="0,0,20,0">

                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Photos}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoSlot">
                                <!-- 90 square with the photo at 84 in its lower left, so the
                                     remove button can overhang the top right corner. -->
                                <Grid WidthRequest="90" HeightRequest="90">
                                    <Border WidthRequest="84"
                                            HeightRequest="84"
                                            HorizontalOptions="Start"
                                            VerticalOptions="End"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}">
                                        <Image Source="{Binding Source}" Aspect="AspectFill" />
                                    </Border>

                                    <!-- Filled on the main photo, hollow on the rest; tapping
                                         one moves that photo to the front, which is what being
                                         main is. On a white disc, since a photo can be any colour. -->
                                    <!-- A 44 square to tap, around the 28 disc that shows. -->
                                    <Grid WidthRequest="44"
                                          HeightRequest="44"
                                          HorizontalOptions="Start"
                                          VerticalOptions="End"
                                          BackgroundColor="Transparent"
                                          SemanticProperties.Description="Make this the main photo">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddItemViewModel}}, Path=MakePrimaryCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsPrimary}" Value="True">
                                                <Setter Property="SemanticProperties.Description" Value="Main photo" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                    <Border WidthRequest="28"
                                            HeightRequest="28"
                                            Margin="6,0,0,6"
                                            HorizontalOptions="Start"
                                            VerticalOptions="End"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="#D9FFFFFF"
                                            AutomationProperties.IsInAccessibleTree="False">
                                        <controls:Icon Glyph="{x:Static controls:Icons.Heart}"
                                                       Size="16"
                                                       IsFilled="{Binding IsPrimary}"
                                                       Color="{StaticResource Ink}">
                                            <controls:Icon.Triggers>
                                                <DataTrigger TargetType="controls:Icon" Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Color" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </controls:Icon.Triggers>
                                        </controls:Icon>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPrimary}" Value="True">
                                                <Setter Property="BackgroundColor" Value="White" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    </Grid>

                                    <!-- Ringed in the canvas colour so it reads as sitting on
                                         top of the photo's corner. -->
                                    <!-- 40 to tap around the 26 that shows; clear of the heart's. -->
                                    <Grid WidthRequest="40"
                                          HeightRequest="40"
                                          HorizontalOptions="End"
                                          VerticalOptions="Start"
                                          BackgroundColor="Transparent"
                                          SemanticProperties.Description="Remove this photo">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddItemViewModel}}, Path=RemovePhotoCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    <Border WidthRequest="26"
                                            HeightRequest="26"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            StrokeThickness="2"
                                            Stroke="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"
                                            AutomationProperties.IsInAccessibleTree="False">
                                        <controls:Icon Glyph="{x:Static controls:Icons.Close}"
                                                       Size="10"
                                                       Weight="3.5"
                                                       Color="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}" />
                                    </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Add more: dashed tiles, gone at the limit. With no photos yet they
                         are the whole strip. -->
                    <Border WidthRequest="84"
                            HeightRequest="84"
                            VerticalOptions="End"
                            IsVisible="{Binding CanAddMorePhotos}"
                            StrokeThickness="2"
                            StrokeDashArray="3,2"
                            Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="Transparent"
                            SemanticProperties.Description="Take a photo">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                        </Border.GestureRecognizers>
                        <controls:Icon Glyph="{x:Static controls:Icons.Camera}"
                                       Size="24"
                                       Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </Border>
                    <Border WidthRequest="84"
                            HeightRequest="84"
                            Margin="6,0,0,0"
                            VerticalOptions="End"
                            IsVisible="{Binding CanAddMorePhotos}"
                            StrokeThickness="2"
                            StrokeDashArray="3,2"
                            Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="Transparent"
                            SemanticProperties.Description="Choose a photo from the gallery">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseFromGalleryCommand}" />
                        </Border.GestureRecognizers>
                        <controls:Icon Glyph="{x:Static controls:Icons.Photo}"
                                       Size="24"
                                       Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="{Binding PhotoCountText}" Style="{StaticResource Caption}" FontSize="12" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Name" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldSurface}">
                <Entry Text="{Binding Name}"
                       Placeholder="What is it?"
                       MaxLength="200"
                       VerticalOptions="Center"
                       SemanticProperties.Description="Name"
                       controls:FocusRing.IsEnabled="True"
                       controls:FocusOnError.Message="{Binding NameError.Text}" />
            </Border>
            <Label Text="{Binding NameError.Text}" Style="{StaticResource FieldError}" />
        </VerticalStackLayout>

        <!-- Quantity and location side by side: both short, both set on most items. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <VerticalStackLayout Spacing="6">
                <Label Text="Quantity" Style="{StaticResource FieldLabel}" />
                <controls:NumericStepper Value="{Binding Quantity}" Minimum="1" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="Location" Style="{StaticResource FieldLabel}" />
                <!-- Opens the place picker; shows the whole path of what was chosen. -->
                <Border Style="{StaticResource FieldSurface}"
                        SemanticProperties.Description="{Binding SelectedLocationPath, StringFormat='Location: {0}. Change'}"
                        SemanticProperties.Hint="Opens the list of locations">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickLocationCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <controls:Icon Glyph="{x:Static controls:Icons.Pin}"
                                       Size="16"
                                       Weight="2.2"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Grid.Column="1"
                               Text="{Binding SelectedLocationPath}"
                               Style="{StaticResource StrongLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="HeadTruncation"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <controls:Icon Grid.Column="2"
                                       Glyph="{x:Static controls:Icons.ChevronDown}"
                                       Size="16"
                                       Weight="2.2"
                                       Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource FieldLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Tags " />
                        <Span Text="{Binding TagCountText}"
                              FontFamily="JakartaRegular"
                              TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Chips and the box for the next one share one white surface, the way the
                 tags will sit together on the item. -->
            <Border Style="{StaticResource FieldSurface}" Padding="8">
                <VerticalStackLayout Spacing="4">
                    <FlexLayout BindableLayout.ItemsSource="{Binding ItemTags}"
                                Wrap="Wrap"
                                Direction="Row"
                                IsVisible="{Binding ItemTags.Count, Converter={StaticResource CountToBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Style="{StaticResource Chip}"
                                        Margin="0,0,8,8"
                                        Padding="12,0,5,0"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                        SemanticProperties.Description="{Binding Name, StringFormat='Tag {0}. Double tap to remove it'}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddItemViewModel}}, Path=RemoveTagCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <!-- Text follows the background: a custom colour can be
                                         any brightness, so white is not always readable. -->
                                    <HorizontalStackLayout Spacing="4" AutomationProperties.IsInAccessibleTree="False">
                                        <Label Text="{Binding Name}"
                                               FontFamily="JakartaBold"
                                               FontSize="14"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                                        <Border WidthRequest="24"
                                                HeightRequest="24"
                                                VerticalOptions="Center"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="#33FFFFFF">
                                            <controls:Icon Glyph="{x:Static controls:Icons.Close}"
                                                           Size="10"
                                                           Weight="3.5"
                                                           Color="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Hidden at the limit rather than greyed out: there is nothing to type. -->
                    <Entry Text="{Binding TagInput}"
                           Placeholder="Add or create a tag"
                           MaxLength="50"
                           ReturnType="Done"
                           IsVisible="{Binding CanAddMoreTags}"
                           ReturnCommand="{Binding AddTagCommand}"
                           SemanticProperties.Description="Add or create a tag"
                           controls:FocusRing.IsEnabled="True" />
                </VerticalStackLayout>
            </Border>

            <!-- Tags already in use that match what is typed, as chips to add. -->
            <FlexLayout BindableLayout.ItemsSource="{Binding TagSuggestions}"
                        Wrap="Wrap"
                        Direction="Row"
                        IsVisible="{Binding HasTagSuggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Tag">
                        <!-- A white pill with a hairline, as "+ Tools" in the mockup. -->
                        <Border Style="{StaticResource ChoiceChip}"
                                Margin="0,0,8,8"
                                Padding="12,0"
                                HeightRequest="32"
                                StrokeShape="RoundRectangle 16"
                                SemanticProperties.Description="{Binding Name, StringFormat='Add tag {0}'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddItemViewModel}}, Path=SelectSuggestionCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name, StringFormat='+ {0}'}"
                                   FontFamily="JakartaSemiBold"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource FieldLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Description " />
                        <Span Text="· optional"
                              FontFamily="JakartaRegular"
                              TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Border Style="{StaticResource FieldSurface}" Padding="12,4">
                <Editor Text="{Binding Description}"
                        Placeholder="Size, condition, anything that helps find it"
                        HeightRequest="88"
                        MaxLength="1000"
                        SemanticProperties.Description="Description"
                        controls:FocusRing.IsEnabled="True" />
            </Border>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>
