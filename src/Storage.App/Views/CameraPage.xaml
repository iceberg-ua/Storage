<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:camera="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.Camera"
             xmlns:views="clr-namespace:Storage.App.Views"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             x:Class="Storage.App.Views.CameraPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0E0F0F"
             Title="Take Photo">

    <ContentPage.Resources>
        <!-- Controls on the camera's dark panel, so they carry their own contrast rather
             than the app's theme-aware colours. -->
        <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="#262A29" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- The shutter: a white ring with a white disc inside it. -->
        <Style x:Key="Shutter" TargetType="Border">
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="80" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="StrokeThickness" Value="5" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeShape" Value="RoundRectangle 40" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <!-- Round controls over the preview: black at half strength. -->
        <Style x:Key="PreviewIcon" TargetType="controls:IconButton" BasedOn="{StaticResource BaseIconButton}">
            <Setter Property="BackgroundColor" Value="#80000000" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- Live preview above, controls on the dark panel below it, as in the mockup. -->
        <Grid x:Name="LiveLayer" IsVisible="False" RowDefinitions="*,Auto">
            <camera:CameraView x:Name="Camera" />

            <!-- Where to aim: four corners around the middle of the preview. -->
            <Path WidthRequest="240"
                  HeightRequest="240"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Aspect="None"
                  Stroke="#CCFFFFFF"
                  StrokeThickness="3"
                  StrokeLineCap="Round"
                  InputTransparent="True"
                  AutomationProperties.IsInAccessibleTree="False"
                  Data="M1.5 36V13.5A12 12 0 0 1 13.5 1.5H36 M204 1.5H226.5A12 12 0 0 1 238.5 13.5V36 M1.5 204V226.5A12 12 0 0 0 13.5 238.5H36 M204 238.5H226.5A12 12 0 0 0 238.5 226.5V204" />

            <!-- Taking one photo for a form: Gallery, the shutter, Cancel; each photo is
                 reviewed before it goes back. -->
            <Grid x:Name="SingleBar"
                  Grid.Row="1"
                  ColumnDefinitions="*,Auto,*"
                  HeightRequest="160"
                  Padding="20,0,20,28"
                  BackgroundColor="#0E0F0F">
                <controls:IconButton Glyph="{x:Static controls:Icons.Photo}"
                                     IconSize="24"
                                     IconWeight="1.8"
                                     Style="{StaticResource BaseIconButton}"
                                     BackgroundColor="#262A29"
                                     TextColor="White"
                                     StrokeShape="RoundRectangle 16"
                                     WidthRequest="56"
                                     HeightRequest="56"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     Clicked="OnGalleryClicked"
                                     SemanticProperties.Description="Choose from gallery" />

                <Border Grid.Column="1" Style="{StaticResource Shutter}" VerticalOptions="Center"
                        SemanticProperties.Description="Take photo">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShutterTapped" />
                    </Border.GestureRecognizers>
                    <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="White" />
                </Border>

                <Button Grid.Column="2"
                        Text="Cancel"
                        Style="{StaticResource OverlayButton}"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnCancelClicked" />
            </Grid>

            <!-- Snap: photos one after another for a new item, kept as they are taken,
                 then Next to the form. Where it will go is set here, before the form. -->
            <Grid x:Name="SnapTopBar"
                  IsVisible="False"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  Padding="20,20,20,0"
                  VerticalOptions="Start">
                <controls:IconButton Glyph="{x:Static controls:Icons.Close}"
                                     IconSize="18"
                                     IconWeight="2.4"
                                     Style="{StaticResource PreviewIcon}"
                                     Clicked="OnCancelClicked"
                                     SemanticProperties.Description="Close the camera" />
                <Border x:Name="PlacePill"
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        HeightRequest="40"
                        Padding="12,0,14,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#80000000"
                        SemanticProperties.Hint="Opens the list of locations">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlaceTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                        <controls:Icon Glyph="{x:Static controls:Icons.Pin}" Size="15" Weight="2.2" Color="White" />
                        <Label x:Name="PlaceLabel"
                               Text="No location"
                               TextColor="White"
                               FontFamily="JakartaBold"
                               FontSize="14"
                               MaximumWidthRequest="200"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <controls:Icon Glyph="{x:Static controls:Icons.ChevronDown}" Size="14" Weight="2.4" Color="White" />
                    </HorizontalStackLayout>
                </Border>
                <!-- Balances the close button, so the pill sits in the middle. -->
                <ContentView Grid.Column="2" WidthRequest="44" />
            </Grid>

            <Grid x:Name="SnapBottomBar"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  HeightRequest="224"
                  Padding="20,18,20,28"
                  BackgroundColor="#0E0F0F">
                <!-- What has been taken so far: tap one to drop it. The first is the main
                     photo, marked with the heart as on the form. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="SnapStrip" Spacing="1" HeightRequest="59">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="views:SnapThumb">
                                    <Grid WidthRequest="59" HeightRequest="59"
                                          SemanticProperties.Description="{Binding Description}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSnapPhotoTapped" CommandParameter="{Binding FileName}" />
                                        </Grid.GestureRecognizers>
                                        <Border WidthRequest="52"
                                                HeightRequest="52"
                                                HorizontalOptions="Start"
                                                VerticalOptions="End"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Stroke" Value="White" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image Source="{Binding FileName, Converter={StaticResource PhotoSourceConverter}}" Aspect="AspectFill" />
                                        </Border>
                                        <Border WidthRequest="20"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                StrokeThickness="0"
                                                StrokeShape="Ellipse"
                                                BackgroundColor="{StaticResource Primary}"
                                                IsVisible="{Binding IsPrimary}">
                                            <controls:Icon Glyph="{x:Static controls:Icons.Heart}" Size="13" IsFilled="True" Color="White" Margin="0,1,0,0" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <Label x:Name="SnapCountLabel"
                           Grid.Column="1"
                           TextColor="#CCFFFFFF"
                           FontFamily="JakartaSemiBold"
                           FontSize="13"
                           VerticalOptions="Center" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                    <controls:IconButton Glyph="{x:Static controls:Icons.Photo}"
                                         IconSize="24"
                                         IconWeight="1.8"
                                         Style="{StaticResource BaseIconButton}"
                                         BackgroundColor="#262A29"
                                         TextColor="White"
                                         StrokeShape="RoundRectangle 16"
                                         WidthRequest="56"
                                         HeightRequest="56"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Center"
                                         Clicked="OnGalleryClicked"
                                         SemanticProperties.Description="Add photos from the gallery" />
                    <Border Grid.Column="1" Style="{StaticResource Shutter}"
                            SemanticProperties.Description="Take photo">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShutterTapped" />
                        </Border.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="White" />
                    </Border>
                    <controls:IconButton x:Name="NextButton"
                                         Grid.Column="2"
                                         Text="Next"
                                         Glyph="{x:Static controls:Icons.ChevronRight}"
                                         IsIconAfter="True"
                                         Style="{StaticResource PrimaryPill}"
                                         Shadow="{x:Null}"
                                         IconSize="18"
                                         IconWeight="2.4"
                                         TextColor="White"
                                         BackgroundColor="{StaticResource Primary}"
                                         Spacing="6"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"
                                         Clicked="OnNextClicked" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Review state: the capture, before it is committed to the item -->
        <Grid x:Name="ReviewLayer" IsVisible="False">
            <Image x:Name="ReviewImage" Aspect="AspectFit" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15"
                  VerticalOptions="End"
                  Padding="20,20,20,40">
                <Button Grid.Column="0"
                        Text="Retake"
                        Style="{StaticResource OverlayButton}"
                        Clicked="OnRetakeClicked" />
                <Button Grid.Column="1"
                        Text="Use photo"
                        Clicked="OnUsePhotoClicked" />
            </Grid>
        </Grid>

        <!-- No camera / permission refused -->
        <VerticalStackLayout x:Name="MessageLayer"
                             IsVisible="False"
                             Padding="30"
                             Spacing="20"
                             VerticalOptions="Center">
            <Label x:Name="MessageLabel"
                   TextColor="White"
                   FontSize="16"
                   HorizontalTextAlignment="Center" />
            <Button x:Name="GalleryFallbackButton"
                    Text="Choose from gallery"
                    IsVisible="False"
                    Clicked="OnGalleryClicked" />
            <Button x:Name="SettingsButton"
                    Text="Open app settings"
                    IsVisible="False"
                    Clicked="OnSettingsClicked" />
            <!-- Snap only: a camera that cannot open must not stop a new item. -->
            <Button x:Name="ContinueButton"
                    Text="Continue without the camera"
                    IsVisible="False"
                    Clicked="OnNextClicked" />
            <Button Text="Back"
                    Style="{StaticResource OverlayButton}"
                    Clicked="OnCancelClicked" />
        </VerticalStackLayout>

        <ActivityIndicator x:Name="BusyIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           Color="White"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>

</ContentPage>
