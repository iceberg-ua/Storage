<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.LocationsPage"
             x:DataType="vm:LocationsViewModel"
             Title="Locations">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header: search, then add. -->
        <HorizontalStackLayout Grid.Row="0"
                               Margin="10"
                               Spacing="10"
                               HorizontalOptions="End">
            <Button Text="{Binding Search.ToggleIcon}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding Search.ToggleCommand}"
                    SemanticProperties.Description="{Binding Search.ToggleDescription}"
                    ToolTipProperties.Text="{Binding Search.ToggleDescription}" />
            <Button Text="➕"
                    Style="{StaticResource IconButton}"
                    Command="{Binding NavigateToAddLocationCommand}"
                    SemanticProperties.Description="Add location"
                    ToolTipProperties.Text="Add location" />
        </HorizontalStackLayout>

        <!-- The same toolbar the items page uses, so the search does not change shape
             depending on which tab it was opened from. -->
        <views:SearchToolbar x:Name="Toolbar"
                             Grid.Row="1"
                             BindingContext="{Binding Search}" />

        <!-- Locations: every location when browsing, the matches when searching.
             Swipe-to-delete lives here only — this is the page that manages them. -->
        <RefreshView Grid.Row="2"
                     BindingContext="{Binding Search}"
                     IsVisible="{Binding ShowLocationList}"
                     IsRefreshing="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=IsLoading}"
                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=LoadLocationsCommand}">
            <CollectionView ItemsSource="{Binding Locations}"
                            ItemTemplate="{StaticResource DeletableLocationRow}"
                            EmptyViewTemplate="{StaticResource EmptyState}" />
        </RefreshView>

        <!-- Items, when the toggle is flipped: found without leaving this page. -->
        <CollectionView Grid.Row="2"
                        BindingContext="{Binding Search}"
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding ShowItemList}"
                        ItemTemplate="{StaticResource ItemRow}"
                        EmptyViewTemplate="{StaticResource EmptyState}" />
    </Grid>

</ContentPage>
