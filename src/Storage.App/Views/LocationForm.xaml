<?xml version="1.0" encoding="utf-8" ?>
<!-- The location's fields, without the header or Save: shared by the edit page and the
     create page, which each put their own around it. Bound to an AddLocationViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             x:Class="Storage.App.Views.LocationForm"
             x:DataType="vm:AddLocationViewModel">

    <VerticalStackLayout Spacing="20">

        <!-- One photo at most: the picture you recognise the place by. Taking or picking
             another replaces it. -->
        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource FieldLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Photo " />
                        <Span Text="· optional"
                              FontFamily="JakartaRegular"
                              TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Border Style="{StaticResource Card}" Padding="8,8,14,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <!-- Tapping the frame takes a photo, with or without one there. -->
                    <Border WidthRequest="112"
                            HeightRequest="84"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"
                            SemanticProperties.Description="{Binding PhotoFrameDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                        </Border.GestureRecognizers>
                        <Grid AutomationProperties.IsInAccessibleTree="False">
                            <controls:Icon Glyph="{x:Static controls:Icons.Photo}"
                                           Size="26"
                                           Weight="1.6"
                                           Opacity="0.35"
                                           Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"
                                           IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}}" />
                            <Image Source="{Binding PhotoFileName, Converter={StaticResource ThumbnailSourceConverter}}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding HasPhoto}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="Shown at the top of the location and on its card"
                               Style="{StaticResource Caption}"
                               FontSize="12"
                               LineHeight="1.4" />
                        <HorizontalStackLayout Spacing="6">
                            <controls:IconButton Glyph="{x:Static controls:Icons.Camera}"
                                                 Style="{StaticResource SoftPill}"
                                                 HeightRequest="36"
                                                 MinimumHeightRequest="36"
                                                 StrokeShape="RoundRectangle 18"
                                                 Padding="14,0"
                                                 Command="{Binding TakePhotoCommand}"
                                                 SemanticProperties.Description="Take a photo" />
                            <controls:IconButton Glyph="{x:Static controls:Icons.Photo}"
                                                 Style="{StaticResource SoftPill}"
                                                 HeightRequest="36"
                                                 MinimumHeightRequest="36"
                                                 StrokeShape="RoundRectangle 18"
                                                 Padding="14,0"
                                                 Command="{Binding ChooseFromGalleryCommand}"
                                                 SemanticProperties.Description="Choose a photo from the gallery" />
                            <controls:IconButton Text="Remove"
                                                 Style="{StaticResource DangerTextIcon}"
                                                 HeightRequest="36"
                                                 MinimumHeightRequest="36"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 Command="{Binding RemovePhotoCommand}"
                                                 IsVisible="{Binding HasPhoto}"
                                                 SemanticProperties.Description="Remove the photo" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Name" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldSurface}">
                <Entry Text="{Binding Name}"
                       Placeholder="Garage, kitchen, a box…"
                       MaxLength="100"
                       VerticalOptions="Center"
                       SemanticProperties.Description="Name"
                       controls:FocusRing.IsEnabled="True"
                       controls:FocusOnError.Message="{Binding NameError.Text}" />
            </Border>
            <Label Text="{Binding NameError.Text}" Style="{StaticResource FieldError}" />
        </VerticalStackLayout>

        <!-- Opens the place picker, which leaves out this location and everything inside
             it; shows the whole path of what was chosen. -->
        <VerticalStackLayout Spacing="6">
            <Label Text="Inside" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldSurface}"
                    SemanticProperties.Description="{Binding ParentPath, StringFormat='Inside: {0}. Change'}"
                    SemanticProperties.Hint="Opens the list of locations">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickParentCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" AutomationProperties.IsInAccessibleTree="False">
                    <controls:Icon Glyph="{x:Static controls:Icons.Places}"
                                   Size="16"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Grid.Column="1"
                           Text="{Binding ParentPath}"
                           Style="{StaticResource StrongLabel}"
                           VerticalOptions="Center"
                           MaxLines="1"
                           LineBreakMode="HeadTruncation" />
                    <Label Grid.Column="2"
                           Text="Change"
                           FontFamily="JakartaSemiBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource FieldLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Description " />
                        <Span Text="· shown on one line in lists, found by search"
                              FontFamily="JakartaRegular"
                              TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Border Style="{StaticResource FieldSurface}" Padding="12,4">
                <Editor Text="{Binding Description}"
                        Placeholder="What's here, or how to find it"
                        HeightRequest="72"
                        MaxLength="1000"
                        SemanticProperties.Description="Description"
                        controls:FocusRing.IsEnabled="True" />
            </Border>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>
