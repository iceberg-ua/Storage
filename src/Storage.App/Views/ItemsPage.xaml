<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.ItemsPage"
             x:DataType="vm:ItemsViewModel"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header. "Edit location" only applies when scoped to a single location. -->
        <HorizontalStackLayout Grid.Row="0"
                               Margin="10"
                               Spacing="10"
                               HorizontalOptions="End">
            <Button Text="{Binding Search.ToggleIcon}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding Search.ToggleCommand}"
                    SemanticProperties.Description="{Binding Search.ToggleDescription}"
                    ToolTipProperties.Text="{Binding Search.ToggleDescription}" />
            <Button Text="✏️"
                    Style="{StaticResource IconButton}"
                    Command="{Binding EditLocationCommand}"
                    IsVisible="{Binding IsLocationView}"
                    SemanticProperties.Description="Edit location"
                    ToolTipProperties.Text="Edit location" />
            <Button Text="➕"
                    Style="{StaticResource IconButton}"
                    Command="{Binding NavigateToAddItemCommand}"
                    SemanticProperties.Description="Add item"
                    ToolTipProperties.Text="Add item" />
        </HorizontalStackLayout>

        <views:SearchToolbar x:Name="Toolbar"
                             Grid.Row="1"
                             BindingContext="{Binding Search}" />

        <!-- Items: everything here when browsing, the matches when searching. -->
        <RefreshView Grid.Row="2"
                     BindingContext="{Binding Search}"
                     IsVisible="{Binding ShowItemList}"
                     IsRefreshing="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=IsLoading}"
                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            ItemTemplate="{StaticResource ItemRow}"
                            EmptyViewTemplate="{StaticResource EmptyState}" />
        </RefreshView>

        <!-- Locations: this location's children when browsing, the matches when searching. -->
        <CollectionView Grid.Row="2"
                        BindingContext="{Binding Search}"
                        ItemsSource="{Binding Locations}"
                        IsVisible="{Binding ShowLocationList}"
                        ItemTemplate="{StaticResource LocationRow}"
                        EmptyViewTemplate="{StaticResource EmptyState}" />
    </Grid>

</ContentPage>
