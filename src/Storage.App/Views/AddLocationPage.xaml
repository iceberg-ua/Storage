<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.AddLocationPage"
             x:DataType="vm:AddLocationViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False">

    <!-- ✕ and the title on top, the fields scrolling under them, Save pinned below. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,20,20,12">
            <Button Text="✕"
                    Style="{StaticResource RoundIconButton}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="Cancel" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource Title}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,6,20,24" Spacing="20">

                <views:LocationForm />

                <!-- Only once the location exists: a shortcut to fill it, and the way to
                     remove it. Delete stays text-only, well away from Save. -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditMode}">
                    <Button Text="📷  Add item here"
                            Style="{StaticResource SoftPrimaryButton}"
                            Command="{Binding AddItemHereCommand}"
                            SemanticProperties.Description="Add an item here: opens the camera" />
                    <Button Text="🗑  Delete location"
                            Style="{StaticResource DangerTextButton}"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Command="{Binding DeleteCommand}"
                            SemanticProperties.Description="Delete location" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Style="{StaticResource SaveBar}">
            <Button Text="{Binding SaveText}" Command="{Binding SaveLocationCommand}" />
        </Border>

    </Grid>

</ContentPage>
