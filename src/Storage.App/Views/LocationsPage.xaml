<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             x:Class="Storage.App.Views.LocationsPage"
             x:DataType="vm:LocationsViewModel"
             Title="Locations"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- A top-level location as a row: cover, name, description on one line, and
             what is inside it. Swipe left to delete: this is the page that manages them. -->
        <DataTemplate x:Key="PlaceRow" x:DataType="vm:PlaceTile">
            <SwipeView Margin="20,0,20,10">
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=DeletePlaceCommand}"
                                       CommandParameter="{Binding .}">
                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                  WidthRequest="96">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                    <controls:Icon Glyph="{x:Static controls:Icons.Trash}"
                                                   Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Ink}}" />
                                    <Label Text="Delete"
                                           FontFamily="JakartaBold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Ink}}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.RightItems>

                <Border Style="{StaticResource RaisedCard}"
                        StrokeShape="RoundRectangle 22"
                        Padding="10,10,14,10"
                        SemanticProperties.Description="{Binding Name, StringFormat='Open {0}'}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=OpenPlaceCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="64"
                                HeightRequest="64"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <views:PlaceCover Gap="3" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource StrongLabel}"
                                   FontSize="16"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Description}"
                                   Style="{StaticResource Caption}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding Meta}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="JakartaSemiBold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimarySoft}, Dark={StaticResource OnPrimarySoftDark}}" />
                        </VerticalStackLayout>
                        <controls:Icon Grid.Column="2"
                                       Glyph="{x:Static controls:Icons.ChevronRight}"
                                       Size="18"
                                       Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </Grid>
                </Border>
            </SwipeView>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header: what there is, then search (the Find page, on Places) and add. Items
             come from "New item" below. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8"
              Padding="20,28,20,18">
            <VerticalStackLayout Spacing="2" VerticalOptions="End">
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" FontFamily="JakartaSemiBold" />
                <Label Text="Locations"
                       Style="{StaticResource Display}"
                       SemanticProperties.HeadingLevel="Level1" />
            </VerticalStackLayout>
            <controls:IconButton Grid.Column="1"
                    Glyph="{x:Static controls:Icons.Search}"
                    Style="{StaticResource RoundIcon}"
                    Command="{Binding SearchCommand}"
                    VerticalOptions="End"
                    SemanticProperties.Description="Search locations"
                    ToolTipProperties.Text="Search locations" />
            <controls:IconButton Grid.Column="2"
                    Glyph="{x:Static controls:Icons.Plus}"
                    Text="New"
                    Style="{StaticResource StrongPill}"
                    VerticalOptions="End"
                    Command="{Binding NavigateToCreateCommand}"
                    SemanticProperties.Description="Add a location" />
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadLocationsCommand}">
            <CollectionView ItemsSource="{Binding Places}"
                            ItemTemplate="{StaticResource PlaceRow}">
                <CollectionView.EmptyView>
                    <!-- Only after the first load, so it does not flash up on a cold start. -->
                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center"
                                         IsVisible="{Binding IsLoaded}">
                        <Label Text="No locations yet"
                               Style="{StaticResource Title}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Tap New to add the first place you keep things."
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <views:AppTabBar Grid.Row="2" Current="locations" SnapCommand="{Binding NewItemCommand}" />
    </Grid>

</ContentPage>
