<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:vm="clr-namespace:Storage.App.ViewModels"
                    xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core">

    <!-- The rows a search produces. Shared so a result looks the same whichever page
         is showing it; the commands hang off SearchViewModel, which is the binding
         context of every list that uses these. -->

    <DataTemplate x:Key="ItemRow" x:DataType="models:Item">
        <Frame Margin="10,5"
               Padding="10"
               CornerRadius="5"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
               BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenItemCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <!-- Fixed size either way, so a row with a photo is exactly as tall
                     as one without. -->
                <Border Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        VerticalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Grid>
                        <Label Text="📦"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Image Source="{Binding PrimaryPhotoFileName, Converter={StaticResource PhotoSourceConverter}}"
                               Aspect="AspectFill"
                               IsVisible="{Binding PrimaryPhotoFileName, Converter={StaticResource IsNotNullConverter}}" />
                    </Grid>
                </Border>

                <StackLayout Grid.Column="1">
                    <Label Text="{Binding Name}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <!-- A preview, not the full text: capped so a long description
                         cannot stretch the card. The detail page shows all of it. -->
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding Location.Name, StringFormat='Location: {0}'}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding Location, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />

                    <!-- Read-only tag chips; editing them is the item form's job. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                                Wrap="Wrap"
                                Direction="Row"
                                Margin="0,4,0,0"
                                IsVisible="{Binding Tags.Count, Converter={StaticResource CountToBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Margin="0,0,6,4"
                                        Padding="8,3"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Name}"
                                           FontSize="11"
                                           TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>

                <Label Grid.Column="2"
                       Text="{Binding Quantity, StringFormat='×{0}'}"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="10,0,0,0"
                       IsVisible="{Binding Quantity, Converter={StaticResource GreaterThanOneConverter}}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </Grid>
        </Frame>
    </DataTemplate>

    <DataTemplate x:Key="LocationRow" x:DataType="models:Location">
        <Frame Margin="10,5"
               Padding="10"
               CornerRadius="5"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
               BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenLocationCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>
            <StackLayout>
                <Label Text="{Binding Name}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <!-- A search across the whole tree can return two shelves with the same
                     name, so say which one this is. -->
                <Label Text="{Binding Parent.Name, StringFormat='Parent: {0}'}"
                       FontSize="12"
                       IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </StackLayout>
        </Frame>
    </DataTemplate>

    <!-- The same row, plus swipe-to-delete. Only the Locations tab uses it: deleting
         belongs on the page that manages locations, not in a set of search results. -->
    <DataTemplate x:Key="DeletableLocationRow" x:DataType="models:Location">
        <SwipeView>
            <SwipeView.RightItems>
                <SwipeItems>
                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=DeleteLocationCommand}"
                                   CommandParameter="{Binding .}">
                        <Grid BackgroundColor="#FF3B30"
                              WidthRequest="100"
                              Padding="10">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="🗑️" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Delete" TextColor="White" FontSize="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </SwipeItemView>
                </SwipeItems>
            </SwipeView.RightItems>

            <Frame Margin="10,5"
                   Padding="10"
                   CornerRadius="5"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenLocationCommand}"
                                          CommandParameter="{Binding .}" />
                </Frame.GestureRecognizers>
                <StackLayout>
                    <Label Text="{Binding Name}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label Text="{Binding Parent.Name, StringFormat='Parent: {0}'}"
                           FontSize="12"
                           IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </StackLayout>
            </Frame>
        </SwipeView>
    </DataTemplate>

    <!-- Shared empty state: the panel decides which of the three nothings it is. -->
    <DataTemplate x:Key="EmptyState" x:DataType="vm:SearchViewModel">
        <StackLayout Padding="20" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
            <Label Text="{Binding EmptyTitle}"
                   FontSize="24"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            <Label Text="{Binding EmptyMessage}"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                   Margin="0,10,0,0" />
        </StackLayout>
    </DataTemplate>

</ResourceDictionary>
