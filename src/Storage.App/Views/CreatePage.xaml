<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.CreatePage"
             x:DataType="vm:CreateViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False">

    <!-- The header and the switch stay put, as does Save; only the form between scrolls. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,20,20,0">
            <controls:IconButton Glyph="{x:Static controls:Icons.Close}"
                                 IconSize="16"
                                 IconWeight="2.4"
                                 Style="{StaticResource RoundIcon}"
                                 Command="{Binding CancelCommand}"
                                 SemanticProperties.Description="Cancel" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource Title}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <!-- What is being made. The selected half is the white one. -->
        <Border Grid.Row="1" Style="{StaticResource SegmentTrack}" Margin="20,18,20,6">
            <Grid ColumnDefinitions="*,*">
                <Button Text="Item"
                        Style="{StaticResource Segment}"
                        Command="{Binding SetKindCommand}"
                        CommandParameter="{x:Static vm:CreateKind.Item}"
                        SemanticProperties.Description="Create an item">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsItem}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="FontFamily" Value="JakartaBold" />
                            <Setter Property="Shadow" Value="{StaticResource RaisedShadow}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1"
                        Text="Location"
                        Style="{StaticResource Segment}"
                        Command="{Binding SetKindCommand}"
                        CommandParameter="{x:Static vm:CreateKind.Location}"
                        SemanticProperties.Description="Create a location">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLocation}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="FontFamily" Value="JakartaBold" />
                            <Setter Property="Shadow" Value="{StaticResource RaisedShadow}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- Both forms are kept and only one is shown, so switching back finds the
             other just as it was left. Each sits in a wrapper because the form's own
             BindingContext is its view model, not this page's. -->
        <ScrollView Grid.Row="2">
            <Grid Padding="20,12,20,24">
                <ContentView IsVisible="{Binding IsItem}">
                    <views:ItemForm BindingContext="{Binding Item}" />
                </ContentView>
                <ContentView IsVisible="{Binding IsLocation}">
                    <views:LocationForm BindingContext="{Binding Location}" />
                </ContentView>
            </Grid>
        </ScrollView>

        <Border Grid.Row="3" Style="{StaticResource SaveBar}">
            <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" />
        </Border>

    </Grid>

</ContentPage>
