<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             x:Class="Storage.App.Views.EditTagPage"
             x:DataType="vm:EditTagViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False">

    <!-- ✕ and the title on top, the fields scrolling under them, Save pinned below:
         the same frame as the item and location forms. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,20,20,12">
            <Button Text="✕"
                    Style="{StaticResource RoundIconButton}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="Cancel" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource Title}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,6,20,24" Spacing="22">

                <!-- The chip as it will look on an item, live as the name and colour
                     change. Any colour can be chosen, so this is also where you see
                     whether the text still reads. -->
                <Border Style="{StaticResource Card}"
                        HeightRequest="120"
                        StrokeShape="RoundRectangle 24"
                        AutomationProperties.IsInAccessibleTree="False">
                    <Border HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HeightRequest="44"
                            Padding="22,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{Binding SelectedColor, Converter={StaticResource HexToColorConverter}}">
                        <Label Text="{Binding PreviewName}"
                               FontFamily="JakartaExtraBold"
                               FontSize="18"
                               VerticalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               TextColor="{Binding SelectedColor, Converter={StaticResource HexToTextColorConverter}}" />
                    </Border>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Name" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldSurface}">
                        <Entry Text="{Binding Name}"
                               Placeholder="Camping, tools, winter…"
                               MaxLength="50"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Name"
                               controls:FocusRing.IsEnabled="True"
                               controls:FocusOnError.Message="{Binding NameError.Text}" />
                    </Border>
                    <Label Text="{Binding NameError.Text}" Style="{StaticResource FieldError}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Colour" Style="{StaticResource FieldLabel}" />

                    <!-- Five across. Fixed palette first: every swatch is dark enough for
                         white chip text, so tags stay legible by construction. The chosen
                         one has a tick and a ring with a canvas gap inside it. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Swatches}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteSwatch">
                                <Border Margin="0,0,0,12"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        Padding="3"
                                        StrokeThickness="3"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 30"
                                        BackgroundColor="Transparent"
                                        SemanticProperties.Description="{Binding Description}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditTagViewModel}}, Path=SelectColorCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 24"
                                            BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                            AutomationProperties.IsInAccessibleTree="False">
                                        <Label Text="✓"
                                               FontFamily="JakartaExtraBold"
                                               FontSize="20"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Button Text="Custom colour…"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="14"
                            HorizontalOptions="Start"
                            Command="{Binding ToggleCustomColorCommand}" />

                    <!-- MAUI has no colour picker control, so this is three channels; the
                         preview chip above shows the result. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsCustomColorVisible}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding SelectedColor}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="JakartaSemiBold" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                <Label Grid.Row="0" Text="R" Style="{StaticResource StrongLabel}" VerticalOptions="Center" WidthRequest="20" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}"
                                        SemanticProperties.Description="Red" />

                                <Label Grid.Row="1" Text="G" Style="{StaticResource StrongLabel}" VerticalOptions="Center" WidthRequest="20" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}"
                                        SemanticProperties.Description="Green" />

                                <Label Grid.Row="2" Text="B" Style="{StaticResource StrongLabel}" VerticalOptions="Center" WidthRequest="20" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}"
                                        SemanticProperties.Description="Blue" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Only for a tag that exists: where it is used, and the way to remove it. -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditMode}">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding UsageText}" Style="{StaticResource StrongLabel}" FontSize="15" />
                                <Label Text="Renaming updates all of them"
                                       Style="{StaticResource Caption}"
                                       IsVisible="{Binding HasItems}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Show items"
                                    Style="{StaticResource SoftPrimaryButton}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasItems}"
                                    Command="{Binding ShowItemsCommand}" />
                        </Grid>
                    </Border>

                    <!-- Text-only and well away from Save. -->
                    <Button Text="🗑  Delete tag"
                            Style="{StaticResource DangerTextButton}"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Command="{Binding DeleteCommand}"
                            SemanticProperties.Description="Delete tag" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Style="{StaticResource SaveBar}">
            <Button Text="Save tag" Command="{Binding SaveTagCommand}" />
        </Border>

    </Grid>

</ContentPage>
