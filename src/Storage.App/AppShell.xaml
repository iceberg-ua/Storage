<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Storage.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Storage.App.Views"
    Title="Storage">

    <!-- The tabs and their routes. Shell's own bar is hidden by the Page style: the tab
         pages draw Views/AppTabBar instead, which has the raised camera button between
         Locations and Tags. Home is first, so it is the tab the app opens on. -->
    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Locations"
            ContentTemplate="{DataTemplate views:LocationsPage}"
            Route="locations" />

        <ShellContent
            Title="Tags"
            ContentTemplate="{DataTemplate views:TagsPage}"
            Route="tags" />

        <!-- Every item, and finding one. -->
        <ShellContent
            Title="Find"
            ContentTemplate="{DataTemplate views:FindPage}"
            Route="find" />
    </TabBar>

</Shell>
