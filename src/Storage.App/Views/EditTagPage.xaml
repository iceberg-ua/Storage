<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             x:Class="Storage.App.Views.EditTagPage"
             x:DataType="vm:EditTagViewModel"
             Title="{Binding PageTitle}">

    <!-- Fields scroll; the action buttons stay pinned to the bottom. -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Tag Name" FontSize="16" />
                <Entry Text="{Binding Name}"
                       Placeholder="Enter tag name"
                       MaxLength="50" />

                <Label Text="Colour" FontSize="16" Margin="0,10,0,0" />

                <!-- Fixed palette rather than a free picker: every swatch is dark
                     enough for white chip text, so tags stay legible by construction. -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Swatches}"
                            Wrap="Wrap"
                            Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteSwatch">
                            <Border Margin="0,0,12,12"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0"
                                    StrokeThickness="0"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditTagViewModel}}, Path=SelectColorCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="StrokeThickness" Value="4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Button Text="Custom colour…"
                        Command="{Binding ToggleCustomColorCommand}"
                        HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <!-- MAUI has no colour picker control, so this is three channels and a
                     live preview. Any colour is allowed, which is why the preview shows
                     the name: it is where you see whether the text still reads. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsCustomColorVisible}">

                    <Border Padding="16"
                            StrokeThickness="0"
                            HorizontalOptions="Start"
                            BackgroundColor="{Binding SelectedColor, Converter={StaticResource HexToColorConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Name}"
                               FontSize="14"
                               TextColor="{Binding SelectedColor, Converter={StaticResource HexToTextColorConverter}}" />
                    </Border>

                    <Label Text="{Binding SelectedColor}"
                           FontSize="14"
                           FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="R" VerticalOptions="Center" WidthRequest="20" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="G" VerticalOptions="Center" WidthRequest="20" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="B" VerticalOptions="Center" WidthRequest="20" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" />
                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="20,10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Button Grid.Column="1"
                    Text="Save"
                    Command="{Binding SaveTagCommand}" />
        </Grid>

    </Grid>

</ContentPage>
