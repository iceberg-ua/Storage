<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.PlacePage"
             x:DataType="vm:PlaceViewModel"
             Title="{Binding Name}"
             Shell.NavBarIsVisible="False">

    <!-- The page draws its own back button in the header, over the photo when there is
         one, so Shell's bar is hidden. Android's Back button still pops as usual. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <views:SearchToolbar x:Name="Toolbar"
                             Grid.Row="0"
                             Margin="0,12,0,0"
                             BindingContext="{Binding Search}" />

        <!-- Items stored here, two to a row, under the header. -->
        <CollectionView Grid.Row="1"
                        Margin="8,0"
                        BindingContext="{Binding Search}"
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding ShowItemList}"
                        ItemTemplate="{StaticResource ItemTile}"
                        EmptyViewTemplate="{StaticResource EmptyState}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <views:PlaceHeader BindingContext="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceViewModel}}}" />
            </CollectionView.Header>
        </CollectionView>

        <!-- Locations, when the search toggle is flipped: the same rows as the tabs. -->
        <CollectionView Grid.Row="1"
                        BindingContext="{Binding Search}"
                        ItemsSource="{Binding Locations}"
                        IsVisible="{Binding ShowLocationList}"
                        ItemTemplate="{StaticResource LocationRow}"
                        EmptyViewTemplate="{StaticResource EmptyState}">
            <CollectionView.Header>
                <views:PlaceHeader BindingContext="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceViewModel}}}" />
            </CollectionView.Header>
        </CollectionView>

        <Button Grid.Row="2"
                Text="New item here"
                Command="{Binding NewItemCommand}"
                Margin="16,8,16,16"
                SemanticProperties.Description="{Binding Name, StringFormat='Add a new item to {0}'}" />
    </Grid>

</ContentPage>
