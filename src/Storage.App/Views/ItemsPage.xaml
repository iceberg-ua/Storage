<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.ItemsPage"
             x:DataType="vm:ItemsViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <!-- Tabs sit flush against each other to read as one strip. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header. "Edit location" only applies when scoped to a single location. -->
        <HorizontalStackLayout Grid.Row="0"
                               Margin="10"
                               Spacing="10"
                               HorizontalOptions="End">
            <Button Text="✏️"
                    Style="{StaticResource IconButton}"
                    Command="{Binding EditLocationCommand}"
                    IsVisible="{Binding IsLocationView}"
                    SemanticProperties.Description="Edit location"
                    ToolTipProperties.Text="Edit location" />
            <Button Text="➕"
                    Style="{StaticResource IconButton}"
                    Command="{Binding NavigateToAddItemCommand}"
                    SemanticProperties.Description="Add item"
                    ToolTipProperties.Text="Add item" />
        </HorizontalStackLayout>

        <!-- Tab strip: shown only when this location actually has children. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              Margin="10,0,10,10"
              IsVisible="{Binding ShowTabStrip}">
            <Button Grid.Column="0"
                    Text="Items"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectItemsTabCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsItemsTabSelected}" Value="False">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="Locations"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectChildLocationsTabCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsChildLocationsTabSelected}" Value="False">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Items List -->
        <RefreshView Grid.Row="2"
                     IsVisible="{Binding IsItemsTabSelected}"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadItemsCommand}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Label Text="📦 No items yet"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="{Binding EmptyMessage}"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Item">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=DeleteItemCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Grid BackgroundColor="#FF3B30"
                                              WidthRequest="100"
                                              Padding="10">
                                            <VerticalStackLayout VerticalOptions="Center"
                                                                HorizontalOptions="Center">
                                                <Label Text="🗑️"
                                                       FontSize="24"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Delete"
                                                       TextColor="White"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Margin="10,5"
                                   Padding="10"
                                   CornerRadius="5"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=EditItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <!-- Fixed size either way, so a row with a photo
                                         is exactly as tall as one without. -->
                                    <Border Grid.Column="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            Padding="0"
                                            VerticalOptions="Start"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="📦"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding PhotoPath, Converter={StaticResource IsNotNullConverter}}" />
                                        </Grid>
                                    </Border>

                                    <StackLayout Grid.Column="1">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                                        <Label Text="{Binding Location.Name, StringFormat='Location: {0}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               IsVisible="{Binding Location, Converter={StaticResource IsNotNullConverter}}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </StackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding Quantity, StringFormat='×{0}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           Margin="10,0,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Child locations of the location being viewed -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding ChildLocations}"
                        IsVisible="{Binding IsChildLocationsTabSelected}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Location">
                    <Frame Margin="10,5"
                           Padding="10"
                           CornerRadius="5"
                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=OpenChildLocationCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Label Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
