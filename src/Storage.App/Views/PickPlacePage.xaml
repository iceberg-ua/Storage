<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             x:Class="Storage.App.Views.PickPlacePage"
             x:DataType="vm:PickPlaceViewModel"
             Title="{Binding Title}"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False">

    <!-- Modal, over whatever asked for a place. A full page rather than a sheet over the
         one underneath: a see-through modal page is unreliable in Shell on Android. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20,20,20,0" RowSpacing="14">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}"
                       Style="{StaticResource Title}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Subject}"
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding HasSubject}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="✕"
                    Style="{StaticResource RoundIconButton}"
                    Command="{Binding CloseCommand}"
                    VerticalOptions="Start"
                    SemanticProperties.Description="Close without choosing" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FieldSurface}" StrokeShape="RoundRectangle 24" MinimumHeightRequest="48">
            <Entry Text="{Binding SearchText}"
                   Placeholder="Find a location"
                   ClearButtonVisibility="WhileEditing"
                   VerticalOptions="Center"
                   SemanticProperties.Description="Find a location by name" />
        </Border>

        <!-- Where in the tree this list is; each step goes back up to it. Hidden while
             searching, when the list holds matches from every level instead. -->
        <FlexLayout Grid.Row="2"
                    BindableLayout.ItemsSource="{Binding Crumbs}"
                    Wrap="Wrap"
                    IsVisible="{Binding IsBrowsing}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceCrumb">
                    <HorizontalStackLayout>
                        <Label Text=" › "
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding IsFirst, Converter={StaticResource InvertedBoolConverter}}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding Name}"
                               Style="{StaticResource StrongLabel}"
                               FontSize="14"
                               Padding="0,8"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{Binding Name, StringFormat='Go to {0}'}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PickPlaceViewModel}}, Path=OpenCrumbCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Rows}">
            <CollectionView.EmptyView>
                <Label Text="No location matches that name"
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center"
                       Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PickRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,8">
                        <!-- The row chooses; the arrow beside it opens what is inside. -->
                        <Border Style="{StaticResource Card}"
                                Padding="14,10"
                                StrokeShape="RoundRectangle 18"
                                SemanticProperties.Description="{Binding Name, StringFormat='Choose {0}'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PickPlaceViewModel}}, Path=SelectCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <!-- A radio mark, so the choice reads without colour too. -->
                                <Border WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeShape="RoundRectangle 11"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                        VerticalOptions="Center">
                                    <Border WidthRequest="10"
                                            HeightRequest="10"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5"
                                            IsVisible="{Binding IsSelected}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource StrongLabel}" />
                                    <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1"
                                Text="›"
                                Style="{StaticResource RoundIconButton}"
                                FontSize="22"
                                Margin="8,0,0,0"
                                VerticalOptions="Center"
                                IsVisible="{Binding CanOpen}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PickPlaceViewModel}}, Path=OpenLevelCommand}"
                                CommandParameter="{Binding .}"
                                SemanticProperties.Description="{Binding Name, StringFormat='Show what is inside {0}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4"
                Text="{Binding ConfirmText}"
                Command="{Binding ConfirmCommand}"
                Margin="0,8,0,16" />
    </Grid>

</ContentPage>
