<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.AddItemPage"
             x:DataType="vm:AddItemViewModel"
             Title="{Binding PageTitle}">

    <!-- Fields scroll; the action buttons stay pinned to the bottom. -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <views:ItemForm Padding="20" />
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="20,10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Button Grid.Column="1"
                    Text="Save"
                    Command="{Binding SaveItemCommand}" />
        </Grid>

    </Grid>

</ContentPage>
