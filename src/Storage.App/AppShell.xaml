<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Storage.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Storage.App.Views"
    Title="Storage">

    <TabBar>
        <ShellContent
            Title="Items"
            Icon="box.png"
            ContentTemplate="{DataTemplate views:ItemsPage}"
            Route="items" />

        <ShellContent
            Title="Locations"
            Icon="folder.png"
            ContentTemplate="{DataTemplate views:LocationsPage}"
            Route="locations" />
    </TabBar>

</Shell>
