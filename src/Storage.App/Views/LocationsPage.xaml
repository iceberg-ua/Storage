<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.LocationsPage"
             x:DataType="vm:LocationsViewModel"
             Title="Locations">

    <Grid RowDefinitions="Auto,*">
        <!-- Header with Add Button -->
        <Button Grid.Row="0"
                Text="➕"
                Style="{StaticResource IconButton}"
                Command="{Binding NavigateToAddLocationCommand}"
                Margin="10"
                HorizontalOptions="End"
                SemanticProperties.Description="Add location"
                ToolTipProperties.Text="Add location" />

        <!-- Locations List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadLocationsCommand}">
            <CollectionView ItemsSource="{Binding Locations}">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Label Text="📍 No locations yet"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="Tap 'Add Location' to create your first location"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Location">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=DeleteLocationCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Grid BackgroundColor="#FF3B30"
                                              WidthRequest="100"
                                              Padding="10">
                                            <VerticalStackLayout VerticalOptions="Center"
                                                                HorizontalOptions="Center">
                                                <Label Text="🗑️"
                                                       FontSize="24"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Delete"
                                                       TextColor="White"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Margin="10,5"
                                   Padding="10"
                                   CornerRadius="5"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=OpenLocationCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding Parent.Name, StringFormat='Parent: {0}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
