<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.ItemsPage"
             x:DataType="vm:ItemsViewModel"
             Title="My Items">

    <Grid RowDefinitions="Auto,*">
        <!-- Header with Add Button -->
        <Button Grid.Row="0"
                Text="Add Item"
                Command="{Binding NavigateToAddItemCommand}"
                Margin="10"
                HorizontalOptions="End" />

        <!-- Items List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadItemsCommand}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Label Text="📦 No items yet"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="Tap 'Add Item' to get started"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Item">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=DeleteItemCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Grid BackgroundColor="#FF3B30"
                                              WidthRequest="100"
                                              Padding="10">
                                            <VerticalStackLayout VerticalOptions="Center"
                                                                HorizontalOptions="Center">
                                                <Label Text="🗑️"
                                                       FontSize="24"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Delete"
                                                       TextColor="White"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Margin="10,5"
                                   Padding="10"
                                   CornerRadius="5"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=EditItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                                        <Label Text="{Binding Location.Name, StringFormat='Location: {0}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               IsVisible="{Binding Location, Converter={StaticResource IsNotNullConverter}}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </StackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding Quantity, StringFormat='×{0}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           Margin="10,0,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
