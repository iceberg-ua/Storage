<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             xmlns:views="clr-namespace:Storage.App.Views"
             x:Class="Storage.App.Views.AddItemPage"
             x:DataType="vm:AddItemViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False">

    <!-- ✕ and the title on top, the fields scrolling under them, Save pinned below. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,20,20,12">
            <controls:IconButton Glyph="{x:Static controls:Icons.Close}"
                                 IconSize="16"
                                 IconWeight="2.4"
                                 Style="{StaticResource RoundIcon}"
                                 Command="{Binding CancelCommand}"
                                 SemanticProperties.Description="Cancel" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource Title}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <views:ItemForm Padding="20,6,20,24" />
        </ScrollView>

        <Border Grid.Row="2" Style="{StaticResource SaveBar}">
            <Button Text="Save changes" Command="{Binding SaveItemCommand}" />
        </Border>

    </Grid>

</ContentPage>
