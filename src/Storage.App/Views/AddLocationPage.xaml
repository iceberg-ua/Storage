<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             x:Class="Storage.App.Views.AddLocationPage"
             x:DataType="vm:AddLocationViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Location Name" FontSize="16" />
            <Entry Text="{Binding Name}"
                   Placeholder="Enter location name (e.g., 'Garage', 'Kitchen')"
                   MaxLength="100" />

            <Label Text="Parent Location (Optional)" FontSize="16" Margin="0,10,0,0" />
            <Label Text="Select a parent to create a nested location hierarchy"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                   Margin="0,0,0,5" />
            <Picker ItemsSource="{Binding AvailableParents}"
                    SelectedItem="{Binding ParentLocation}"
                    ItemDisplayBinding="{Binding Name}"
                    Title="Select parent location" />

            <!-- Shortcut: only meaningful once the location exists -->
            <Button Text="Add Item Here"
                    Command="{Binding AddItemHereCommand}"
                    IsVisible="{Binding IsEditMode}"
                    Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Button Grid.Column="1"
                        Text="Save"
                        Command="{Binding SaveLocationCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
