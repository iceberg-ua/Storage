<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.FindPage"
             x:DataType="vm:FindViewModel"
             Title="Find"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- A tag filter in force: the tag's own fill, and a cross to take it off. -->
        <DataTemplate x:Key="TagFilterChip" x:DataType="models:Tag">
            <Border Style="{StaticResource Chip}"
                    HeightRequest="34"
                    Padding="12,0,5,0"
                    Margin="0,0,8,8"
                    StrokeShape="RoundRectangle 17"
                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding Name, StringFormat='tag: {0}'}"
                           FontFamily="JakartaBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                    <controls:IconButton Glyph="{x:Static controls:Icons.Close}"
                                         IconSize="12"
                                         IconWeight="3"
                                         Style="{StaticResource BaseIconButton}"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         MinimumWidthRequest="24"
                                         MinimumHeightRequest="24"
                                         StrokeShape="RoundRectangle 12"
                                         BackgroundColor="#33FFFFFF"
                                         TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=RemoveTagFilterCommand}"
                                         CommandParameter="{Binding .}"
                                         SemanticProperties.Description="{Binding Name, StringFormat='Remove the tag filter {0}'}" />
                </HorizontalStackLayout>
            </Border>
        </DataTemplate>

        <!-- A filter to add: a dashed outline, as in the mockup. -->
        <Style x:Key="AddFilterChip" TargetType="Border" BasedOn="{StaticResource SuggestionChip}">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </ContentPage.Resources>

    <!-- No row spacing: the gap above the lists is their margin, so the tab bar's row
         leaves none behind when it is hidden on a pushed search. -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20,20,20,0">

        <!-- A stack, not grid rows, so the parts that are hidden take no spacing either. -->
        <VerticalStackLayout Spacing="16">

        <!-- The box, with Back beside it when this page was pushed from somewhere. The
             place filter sits inside it, before the text it narrows. -->
        <Grid ColumnDefinitions="Auto,*">
            <controls:IconButton Glyph="{x:Static controls:Icons.Back}"
                                 Style="{StaticResource RoundIcon}"
                                 Margin="0,0,10,0"
                                 Command="{Binding BackCommand}"
                                 IsVisible="{Binding IsPushed}"
                                 SemanticProperties.Description="Back" />
            <Border Grid.Column="1"
                    Style="{StaticResource FieldSurface}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="2"
                    HeightRequest="56"
                    Padding="16,0,8,0"
                    Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding HasPlaceFilter}" Value="True">
                        <Setter Property="Padding" Value="10,0,8,0" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <controls:Icon Glyph="{x:Static controls:Icons.Search}"
                                   Margin="0,0,2,0"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   IsVisible="{Binding HasPlaceFilter, Converter={StaticResource InvertedBoolConverter}}" />

                    <Border Style="{StaticResource PlaceChip}"
                            HeightRequest="34"
                            Padding="12,0,5,0"
                            StrokeShape="RoundRectangle 17"
                            IsVisible="{Binding HasPlaceFilter}">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding PlaceFilterLabel}"
                                   Style="{StaticResource StrongLabel}"
                                   FontSize="14"
                                   MaximumWidthRequest="140"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimarySoft}, Dark={StaticResource OnPrimarySoftDark}}" />
                            <controls:IconButton Glyph="{x:Static controls:Icons.Close}"
                                                 IconSize="12"
                                                 IconWeight="3"
                                                 Style="{StaticResource BaseIconButton}"
                                                 WidthRequest="24"
                                                 HeightRequest="24"
                                                 MinimumWidthRequest="24"
                                                 MinimumHeightRequest="24"
                                                 StrokeShape="RoundRectangle 12"
                                                 BackgroundColor="#1F0B5555"
                                                 TextColor="{AppThemeBinding Light={StaticResource OnPrimarySoft}, Dark={StaticResource OnPrimarySoftDark}}"
                                                 Command="{Binding RemovePlaceFilterCommand}"
                                                 SemanticProperties.Description="Remove the place filter and search everywhere" />
                        </HorizontalStackLayout>
                    </Border>

                    <Entry x:Name="Input"
                           Grid.Column="1"
                           Text="{Binding Text}"
                           Placeholder="Search items, locations, tags"
                           ReturnType="Search"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Search items, locations and tags" />

                    <controls:IconButton Grid.Column="2"
                                         Glyph="{x:Static controls:Icons.Close}"
                                         IconSize="14"
                                         IconWeight="2.6"
                                         Style="{StaticResource BaseIconButton}"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         MinimumWidthRequest="32"
                                         MinimumHeightRequest="32"
                                         StrokeShape="RoundRectangle 16"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"
                                         TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                         Command="{Binding ClearTextCommand}"
                                         IsVisible="{Binding HasText}"
                                         SemanticProperties.Description="Clear text" />
                </Grid>
            </Border>
        </Grid>

        <!-- Tag filters in force: a wrapping row of their own, so three or four of them
             wrap instead of running off the edge with their crosses. -->
        <FlexLayout Wrap="Wrap"
                    Margin="0,0,0,-8"
                    IsVisible="{Binding TagFilters.Count, Converter={StaticResource CountToBoolConverter}}"
                    BindableLayout.ItemsSource="{Binding TagFilters}"
                    BindableLayout.ItemTemplate="{StaticResource TagFilterChip}" />

        <!-- While searching: a place to search in, and tags and places whose names match
             what is typed, as filters to add. -->
        <ScrollView Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,0,-20,0"
                    IsVisible="{Binding ShowAddFilter}">
            <HorizontalStackLayout Spacing="8" Padding="0,0,20,0">
                <Label Text="Add filter" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Border Style="{StaticResource AddFilterChip}"
                        IsVisible="{Binding HasPlaceFilter, Converter={StaticResource InvertedBoolConverter}}"
                        SemanticProperties.Description="Search in one place only"
                        SemanticProperties.Hint="Opens the list of locations">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPlaceFilterCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="in: a place" FontFamily="JakartaSemiBold" FontSize="13" VerticalOptions="Center" />
                </Border>
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindSuggestion">
                            <Border Style="{StaticResource AddFilterChip}"
                                    SemanticProperties.Description="{Binding Label, StringFormat='Add the filter {0}'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=ApplySuggestionCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="JakartaSemiBold" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Items | Places, with what each holds. -->
        <Border Style="{StaticResource SegmentTrack}" IsVisible="{Binding ShowSegment}">
            <Grid ColumnDefinitions="*,*">
                <Button Text="{Binding ItemsTabText}"
                        Style="{StaticResource Segment}"
                        Command="{Binding ShowItemsCommand}"
                        SemanticProperties.Description="{Binding ItemsTabDescription}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingItems}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="FontFamily" Value="JakartaBold" />
                            <Setter Property="Shadow" Value="{StaticResource RaisedShadow}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1"
                        Text="{Binding PlacesTabText}"
                        Style="{StaticResource Segment}"
                        Command="{Binding ShowPlacesCommand}"
                        SemanticProperties.Description="{Binding PlacesTabDescription}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingPlaces}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="FontFamily" Value="JakartaBold" />
                            <Setter Property="Shadow" Value="{StaticResource RaisedShadow}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
        </VerticalStackLayout>

        <!-- Pull to refresh over either list, as the Items tab had. -->
        <RefreshView Grid.Row="1"
                     Margin="-20,16,-20,0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <Grid>
                <!-- Items: the matches, or at rest the whole inventory under recent searches and tags. -->
                <CollectionView ItemsSource="{Binding ItemResults}"
                                IsVisible="{Binding ShowingItems}"
                                Footer="{Binding .}">
                    <CollectionView.Header>
                        <!-- BindingContext set in code-behind: a RelativeSource lookup from
                             inside a CollectionView header is unreliable on Android, so the
                             commands below find the view model on this element instead. -->
                        <VerticalStackLayout x:Name="IdleHeader"
                                             Padding="20,6,20,12"
                                             Spacing="22"
                                             IsVisible="{Binding IsIdle}">

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Narrow it down" Style="{StaticResource Caption}" FontFamily="JakartaBold" SemanticProperties.HeadingLevel="Level2" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource SuggestionChip}"
                                            HeightRequest="38"
                                            StrokeShape="RoundRectangle 19"
                                            SemanticProperties.Description="Search in one place only"
                                            SemanticProperties.Hint="Opens the list of locations">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PickPlaceFilterCommand}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                                            <controls:Icon Glyph="{x:Static controls:Icons.Pin}"
                                                           Size="16"
                                                           Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <Label Text="in: a place" FontFamily="JakartaSemiBold" FontSize="14" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Style="{StaticResource SuggestionChip}"
                                            HeightRequest="38"
                                            StrokeShape="RoundRectangle 19"
                                            SemanticProperties.Description="Search by tag"
                                            SemanticProperties.Hint="Opens the list of tags">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PickTagFilterCommand}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                                            <controls:Icon Glyph="{x:Static controls:Icons.Tag}"
                                                           Size="16"
                                                           Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <Label Text="tag: a tag" FontFamily="JakartaSemiBold" FontSize="14" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasRecent}">
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="32">
                                    <Label Text="Recent searches" Style="{StaticResource Caption}" FontFamily="JakartaBold" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                    <Button Grid.Column="1"
                                            Text="Clear"
                                            Style="{StaticResource TextButton}"
                                            FontSize="13"
                                            Padding="0"
                                            Margin="0,-6"
                                            Command="{Binding ClearRecentCommand}"
                                            SemanticProperties.Description="Clear recent searches" />
                                </Grid>
                                <!-- One card, the searches divided inside it. -->
                                <Border Style="{StaticResource Card}" Padding="0,4">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentRow">
                                                <Grid RowDefinitions="Auto,52"
                                                      BackgroundColor="Transparent"
                                                      SemanticProperties.Description="{Binding Search.Label, StringFormat='Search again: {0}'}">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=RunRecentCommand}"
                                                                              CommandParameter="{Binding Search}" />
                                                    </Grid.GestureRecognizers>
                                                    <BoxView HeightRequest="1"
                                                             Margin="16,0"
                                                             IsVisible="{Binding HasDivider}"
                                                             Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
                                                    <!-- The text in a star column, so a long one truncates
                                                         instead of running off the card. -->
                                                    <Grid Grid.Row="1"
                                                          ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12"
                                                          Padding="16,0"
                                                          AutomationProperties.IsInAccessibleTree="False">
                                                    <HorizontalStackLayout Spacing="12">
                                                        <controls:Icon Glyph="{x:Static controls:Icons.Clock}"
                                                                       Size="18"
                                                                       Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                                                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Chips}" Spacing="8" VerticalOptions="Center"
                                                                               IsVisible="{Binding HasChips}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:RecentChip">
                                                                    <Grid>
                                                                        <Border Style="{StaticResource PlaceChip}"
                                                                                HeightRequest="26"
                                                                                Padding="10,0"
                                                                                StrokeShape="RoundRectangle 13"
                                                                                IsVisible="{Binding IsPlace}">
                                                                            <Label Text="{Binding Label}"
                                                                                   FontFamily="JakartaBold"
                                                                                   FontSize="13"
                                                                                   VerticalOptions="Center"
                                                                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimarySoft}, Dark={StaticResource OnPrimarySoftDark}}" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource Chip}"
                                                                                HeightRequest="26"
                                                                                Padding="10,0"
                                                                                StrokeShape="RoundRectangle 13"
                                                                                BackgroundColor="{Binding TagColor, Converter={StaticResource HexToColorConverter}}"
                                                                                IsVisible="{Binding IsTag}">
                                                                            <Label Text="{Binding Label}"
                                                                                   FontFamily="JakartaBold"
                                                                                   FontSize="13"
                                                                                   VerticalOptions="Center"
                                                                                   TextColor="{Binding TagColor, Converter={StaticResource HexToTextColorConverter}}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </HorizontalStackLayout>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Search.Text}"
                                                               VerticalOptions="Center"
                                                               MaxLines="1"
                                                               LineBreakMode="TailTruncation"
                                                               IsVisible="{Binding HasText}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasBrowseTags}">
                                <Label Text="Browse by tag" Style="{StaticResource Caption}" FontFamily="JakartaBold" SemanticProperties.HeadingLevel="Level2" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding BrowseTags}" Wrap="Wrap" Margin="0,0,0,-8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagRow">
                                            <Border Style="{StaticResource Chip}"
                                                    HeightRequest="36"
                                                    StrokeShape="RoundRectangle 18"
                                                    Margin="0,0,8,8"
                                                    BackgroundColor="{Binding Tag.Color, Converter={StaticResource HexToColorConverter}}"
                                                    SemanticProperties.Description="{Binding Description, StringFormat='Show items tagged {0}'}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=AddTagFilterCommand}"
                                                                          CommandParameter="{Binding Tag}" />
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding Tag.Name}"
                                                           FontFamily="JakartaBold"
                                                           FontSize="14"
                                                           VerticalOptions="Center"
                                                           TextColor="{Binding Tag.Color, Converter={StaticResource HexToTextColorConverter}}" />
                                                    <Label Text="{Binding ItemCount}"
                                                           FontSize="14"
                                                           Opacity="0.85"
                                                           VerticalOptions="Center"
                                                           TextColor="{Binding Tag.Color, Converter={StaticResource HexToTextColorConverter}}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>

                            <Label Text="Everything stored" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindItemRow">
                            <Border Style="{StaticResource Card}"
                                    Padding="8,8,16,8"
                                    Margin="20,0,20,10"
                                    SemanticProperties.Description="{Binding Description}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=OpenItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border WidthRequest="60"
                                            HeightRequest="60"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}">
                                        <Image Source="{Binding Item.PrimaryPhotoFileName, Converter={StaticResource ThumbnailSourceConverter}}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding Item.PrimaryPhotoFileName, Converter={StaticResource IsNotNullConverter}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <!-- The name, with the part that matched highlighted. -->
                                        <Label Style="{StaticResource StrongLabel}" MaxLines="2" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Before}" />
                                                    <Span Text="{Binding Match}"
                                                          BackgroundColor="{AppThemeBinding Light=#FCE7A6, Dark=#6B5510}" />
                                                    <Span Text="{Binding After}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasPath}">
                                            <controls:Icon Glyph="{x:Static controls:Icons.Pin}"
                                                           Size="13"
                                                           Weight="2.2"
                                                           Color="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                                            <Label Text="{Binding Path}"
                                                   Style="{StaticResource Caption}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource Chip}"
                                            HeightRequest="26"
                                            Padding="10,0"
                                            StrokeShape="RoundRectangle 13"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"
                                            IsVisible="{Binding ShowQuantity}">
                                        <Label Text="{Binding Item.Quantity, StringFormat='×{0}'}" Style="{StaticResource StrongLabel}" FontSize="13" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.FooterTemplate>
                        <DataTemplate x:DataType="vm:FindViewModel">
                            <Button Text="{Binding OutsideText}"
                                    Style="{StaticResource TextButton}"
                                    IsVisible="{Binding HasOutside}"
                                    Command="{Binding RemovePlaceFilterCommand}"
                                    HorizontalOptions="Center"
                                    Margin="20,0,20,16" />
                        </DataTemplate>
                    </CollectionView.FooterTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="{Binding EmptyText}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               Margin="32" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Places matching the text, anywhere or under the place filter; at rest,
                     every location. Swipe to delete, as on the Locations tab. -->
                <CollectionView ItemsSource="{Binding PlaceResults}"
                                IsVisible="{Binding ShowingPlaces}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindPlaceRow">
                            <SwipeView Margin="20,0,20,10">
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=DeletePlaceCommand}"
                                                       CommandParameter="{Binding .}">
                                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                  WidthRequest="96">
                                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <controls:Icon Glyph="{x:Static controls:Icons.Trash}"
                                                                   Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Ink}}" />
                                                    <Label Text="Delete"
                                                           FontFamily="JakartaBold"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Ink}}"
                                                           HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource Card}"
                                        Padding="16,12"
                                        SemanticProperties.Description="{Binding Description}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FindViewModel}}, Path=OpenPlaceCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Style="{StaticResource StrongLabel}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Before}" />
                                                    <Span Text="{Binding Match}"
                                                          BackgroundColor="{AppThemeBinding Light=#FCE7A6, Dark=#6B5510}" />
                                                    <Span Text="{Binding After}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding Path, StringFormat='Inside {0}'}"
                                               Style="{StaticResource Caption}"
                                               IsVisible="{Binding HasPath}" />
                                    </VerticalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="{Binding PlacesEmptyText}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               Margin="32" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </RefreshView>

        <!-- The tab bar, as on the other tabs; with a place filter its camera starts the
             new item in that place. Not when this page is pushed for a search. -->
        <views:AppTabBar Grid.Row="2"
                         Margin="-20,0"
                         Current="find"
                         SnapCommand="{Binding NewItemCommand}"
                         IsVisible="{Binding IsPushed, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>

</ContentPage>
