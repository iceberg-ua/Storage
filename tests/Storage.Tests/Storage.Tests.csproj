<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Storage.Core\Storage.Core.csproj" />
  </ItemGroup>

  <!-- DesignTokenTests reads these beside the test assembly, so it needs no repo checkout
       around bin/, and a change to any of them makes the build copy it again. -->
  <ItemGroup>
    <None Include="..\..\docs\design\tokens.json" Link="design\tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\screens\*.html" Link="design\screens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Storage.App\Resources\Styles\Colors.xaml" Link="design\Colors.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>