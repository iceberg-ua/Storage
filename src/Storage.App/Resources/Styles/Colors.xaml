<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0F6E6E</Color>
    <Color x:Key="PrimaryDark">#6FC7C7</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#CFE8E8</Color>
    <Color x:Key="SecondaryDarkText">#5FA8A8</Color>
    <Color x:Key="Tertiary">#084A4A</Color>

    <!-- Validation messages. The dark-theme shade is lighter so it reads on a dark page. -->
    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="DangerDark">#F2B8B5</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#062E2E</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Snapshot redesign tokens. Each role has a light and a dark value; pages bind
         them with AppThemeBinding Light={StaticResource X}, Dark={StaticResource XDark}.
         The Gray scale above stays until every page has moved over to these. -->

    <!-- Page ground and the white cards that sit on it. -->
    <Color x:Key="Canvas">#F6F4EF</Color>
    <Color x:Key="CanvasDark">#141412</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1F1E1B</Color>
    <!-- Segment tracks, stepper minus, clear buttons: a step down from Surface. -->
    <Color x:Key="SurfaceSunken">#ECE8DF</Color>
    <Color x:Key="SurfaceSunkenDark">#2A2925</Color>
    <Color x:Key="Hairline">#E4DFD4</Color>
    <Color x:Key="HairlineDark">#34322D</Color>

    <!-- Text. InkMuted clears 4.5:1 on both Canvas and Surface in each theme. -->
    <Color x:Key="Ink">#1C1B19</Color>
    <Color x:Key="InkDark">#F3F1EC</Color>
    <Color x:Key="InkMuted">#5F5B53</Color>
    <Color x:Key="InkMutedDark">#ABA69C</Color>

    <!-- The accent is Primary / PrimaryDark above, with White / PrimaryDarkText on it;
         it is not redefined here so the two cannot drift apart. Ink-filled buttons
         (Edit, New place) likewise use Ink / InkDark with White / Ink on them. -->

    <!-- Soft accent fill for location chips and secondary accent buttons. -->
    <Color x:Key="PrimarySoft">#DCEDEA</Color>
    <Color x:Key="PrimarySoftDark">#173C3B</Color>
    <Color x:Key="OnPrimarySoft">#0B5555</Color>
    <Color x:Key="OnPrimarySoftDark">#A6E2DC</Color>

    <!-- The Snap button's glow: the accent at 35% in light, plain shade in dark,
         where a coloured glow reads as a halo rather than a shadow. -->
    <SolidColorBrush x:Key="PrimaryShadowBrush" Color="#590F6E6E" />
    <SolidColorBrush x:Key="PrimaryShadowDarkBrush" Color="#80000000" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>