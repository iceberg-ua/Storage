<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.ItemDetailPage"
             x:DataType="vm:ItemDetailViewModel"
             Title="{Binding Name}">

    <ContentPage.Resources>
        <!-- Every field is a caption over its value, so the page scans as a list of
             answers rather than a wall of labelled rows. -->
        <Style x:Key="FieldCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </Style>

        <Style x:Key="FieldValue" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        </Style>
    </ContentPage.Resources>

    <Grid>

        <ScrollView>
            <VerticalStackLayout>

                <!-- Full width and edge to edge: on a detail page the photo is the
                     fastest way to confirm this is the thing you were looking for.
                     AspectFit, not AspectFill — a crop can hide the very detail that
                     tells two similar items apart. Hidden entirely when there is no
                     photo, rather than leaving a grey band that says nothing. -->
                <Grid HeightRequest="280"
                      IsVisible="{Binding HasPhotos}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

                    <!-- Swipe for the rest of the set, starting on the primary. Its
                         scroll is horizontal, so it does not fight the page's own. -->
                    <CarouselView ItemsSource="{Binding Photos}"
                                  IndicatorView="PhotoIndicator"
                                  Loop="False"
                                  HorizontalScrollBarVisibility="Never">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:ItemPhoto">
                                <Image Source="{Binding FileName, Converter={StaticResource PhotoSourceConverter}}"
                                       Aspect="AspectFit"
                                       SemanticProperties.Description="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemDetailViewModel}}, Path=Name, StringFormat='Photo of {0}'}" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Dots earn their space only once there is a second photo. They sit
                         over the photo, which can be any colour in either theme, so they
                         carry their own scrim and are white on it rather than taking a
                         theme colour that a pale photo would swallow. -->
                    <Border IsVisible="{Binding HasMultiplePhotos}"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            Margin="0,0,0,10"
                            Padding="10,5"
                            StrokeThickness="0"
                            BackgroundColor="#66000000">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <IndicatorView x:Name="PhotoIndicator"
                                       IndicatorColor="#80FFFFFF"
                                       SelectedIndicatorColor="White" />
                    </Border>
                </Grid>

                <VerticalStackLayout Padding="20" Spacing="18">

                    <!-- Both actions are icon buttons beside the name, not a bottom
                         bar. The edit form's Cancel and Save occupy both bottom slots,
                         and either one pops straight back to this page — so a button
                         down here arrives under the finger that just tapped, which is
                         how Delete used to catch a double tap on Save. Up beside the
                         name neither shares a position with anything. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="26"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <Button Grid.Column="1"
                                Text="✏️"
                                Style="{StaticResource IconButton}"
                                Command="{Binding EditCommand}"
                                SemanticProperties.Description="Edit item"
                                ToolTipProperties.Text="Edit item" />

                        <!-- The delete red the swipe actions already use, so destructive
                             means the same colour everywhere in the app. -->
                        <Button Grid.Column="2"
                                Text="🗑️"
                                Style="{StaticResource IconButton}"
                                Command="{Binding DeleteCommand}"
                                BackgroundColor="#FF3B30"
                                SemanticProperties.Description="Delete item"
                                ToolTipProperties.Text="Delete item" />
                    </Grid>

                    <!-- Read-only chips, same treatment as the list rows. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                                Wrap="Wrap"
                                Direction="Row"
                                IsVisible="{Binding HasTags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Margin="0,0,8,8"
                                        Padding="12,6"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           TextColor="{Binding Color, Converter={StaticResource HexToTextColorConverter}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Quantity" Style="{StaticResource FieldCaption}" />
                        <Label Text="{Binding Quantity}" Style="{StaticResource FieldValue}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Location" Style="{StaticResource FieldCaption}" />
                        <Label Text="{Binding LocationName}" Style="{StaticResource FieldValue}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasDescription}">
                        <Label Text="Description" Style="{StaticResource FieldCaption}" />
                        <Label Text="{Binding Description}" Style="{StaticResource FieldValue}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Added" Style="{StaticResource FieldCaption}" />
                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                               Style="{StaticResource FieldValue}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
