<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Storage.App.ViewModels"
             xmlns:views="clr-namespace:Storage.App.Views"
             xmlns:controls="clr-namespace:Storage.App.Controls"
             xmlns:models="clr-namespace:Storage.Core.Models;assembly=Storage.Core"
             x:Class="Storage.App.Views.PlacePage"
             x:DataType="vm:PlaceViewModel"
             Title="{Binding Name}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- An item as a photo tile, for the two-column grid on a location's page: you
             recognise a thing by sight faster than by its name. Padding gives the gutter,
             since GridItemsLayout spacing would also indent the full-width header. -->
        <DataTemplate x:Key="ItemTile" x:DataType="models:Item">
            <VerticalStackLayout Padding="6,0,6,14" Spacing="8">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceViewModel}}, Path=OpenItemCommand}"
                                          CommandParameter="{Binding .}" />
                </VerticalStackLayout.GestureRecognizers>

                <Border HeightRequest="150"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}">
                    <Grid>
                        <controls:Icon Glyph="{x:Static controls:Icons.Photo}"
                                       Size="30"
                                       Weight="1.6"
                                       Opacity="0.35"
                                       Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Image Source="{Binding PrimaryPhotoFileName, Converter={StaticResource ThumbnailSourceConverter}}"
                               Aspect="AspectFill"
                               IsVisible="{Binding PrimaryPhotoFileName, Converter={StaticResource IsNotNullConverter}}"
                               SemanticProperties.Description="{Binding Name, StringFormat='Photo of {0}'}" />

                        <!-- Over the photo, so it carries its own white pill rather than
                             relying on whatever colour the photo happens to be there. -->
                        <Border Style="{StaticResource Chip}"
                                HeightRequest="24"
                                Padding="8,0"
                                Margin="10"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                IsVisible="{Binding Quantity, Converter={StaticResource GreaterThanOneConverter}}">
                            <Label Text="{Binding Quantity, StringFormat='×{0}'}"
                                   Style="{StaticResource StrongLabel}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="4" Padding="4,0">
                    <Label Text="{Binding Name}"
                           Style="{StaticResource StrongLabel}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />

                    <!-- Tag colours only: the names would not fit two to a row, and the
                         detail page shows them in full. -->
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tags}"
                                           Spacing="6"
                                           IsVisible="{Binding Tags.Count, Converter={StaticResource CountToBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border WidthRequest="8"
                                        HeightRequest="8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                        SemanticProperties.Description="{Binding Name}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- The page draws its own back button in the header, over the photo when there is
         one, so Shell's bar is hidden. Android's Back button still pops as usual. -->
    <Grid RowDefinitions="*,Auto">

        <!-- Items stored here, two to a row, under the header. The locations inside this
             one are the header's chips. The wrapper hides it, rather than just covering
             it, while the location is missing, so a screen reader does not reach the list
             underneath the message. -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsMissing, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView Margin="14,0"
                            ItemsSource="{Binding Items}"
                            ItemTemplate="{StaticResource ItemTile}">
                <CollectionView.EmptyView>
                    <Label Text="Nothing stored here itself yet. Tap New item here to add something."
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center"
                           Margin="32,16" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <!-- BindingContext set in code-behind; see PlaceHeader.xaml. -->
                    <views:PlaceHeader x:Name="Header" />
                </CollectionView.Header>
            </CollectionView>
        </Grid>

        <controls:IconButton Grid.Row="1"
                Glyph="{x:Static controls:Icons.Camera}"
                Text="New item here"
                Style="{StaticResource PrimaryPill}"
                Command="{Binding NewItemCommand}"
                IsVisible="{Binding IsMissing, Converter={StaticResource InvertedBoolConverter}}"
                Margin="20,8,20,20"
                SemanticProperties.Description="{Binding Name, StringFormat='New item in {0}: opens the camera'}" />

        <!-- Deleted while this page was underneath another one, from a search on a
             tab. Said plainly, with a way out, instead of popping during OnAppearing. -->
        <VerticalStackLayout Grid.RowSpan="2"
                             IsVisible="{Binding IsMissing}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"
                             Padding="32"
                             Spacing="16"
                             VerticalOptions="Fill">
            <Label Text="This location no longer exists"
                   Style="{StaticResource Title}"
                   HorizontalTextAlignment="Center"
                   Margin="0,120,0,0" />
            <Button Text="Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
